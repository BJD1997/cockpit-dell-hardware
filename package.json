{
  "private": true,
  "workspaces": [
    "45drives-system",
    "dell-disks",
    "dell-system",
    "houston-common",
    "houston-common/houston-common-*"
  ],
  "scripts": {
    "build:common": "yarn workspace @45drives/houston-common run build:common",
    "build:system": "yarn workspace 45drives-system run build",
    "build:dell-disks": "yarn workspace dell-disks run build",
    "build:dell-system": "yarn workspace dell-system run build",
    "build": "yarn build:common && yarn build:system && yarn build:dell-disks && yarn build:dell-system"
  },
  "packageManager": "yarn@4.17.1"
}
