#!/usr/bin/env python3
import json
import subprocess


def dmidecode(keyword):
    result = subprocess.run(["dmidecode", "-s", keyword], capture_output=True, text=True)
    if result.returncode != 0:
        return "?"
    lines = [l.strip() for l in result.stdout.splitlines() if l.strip() and not l.strip().startswith("#")]
    return lines[0] if lines else "?"


def main():
    info = {
        "Manufacturer": dmidecode("system-manufacturer"),
        "Model": dmidecode("system-product-name"),
        "Serial": dmidecode("system-serial-number"),
        "BIOS Version": dmidecode("bios-version"),
        "BIOS Release Date": dmidecode("bios-release-date"),
    }
    print(json.dumps(info, indent=4))


if __name__ == "__main__":
    main()
